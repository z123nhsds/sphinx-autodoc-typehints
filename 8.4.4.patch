+    # =====================================================================
+    # Annotated[T, Doc(...)] — PEP 727 metadata extraction
+    # =====================================================================
+    # ``typing.Annotated[T, *metadata]`` carries ``__origin__`` (the base
+    # type ``T``) and ``__metadata__`` (a tuple of arbitrary annotation
+    # markers).  During formatting we render *only the origin type* ``T``,
+    # discarding all metadata.  The ``Doc(...)`` payload is separately
+    # consumed by ``_extract_doc_description()`` in ``__init__.py`` so that
+    # the description text lands next to the ``:param:`` / ``:return:``
+    # entries in the rendered docstring.
+    #
+    # Example annotation:
+    #
+    #     def greet(name: Annotated[str, Doc("The person's name")]) -> str:
+    #
+    # Rendered output (Sphinx field-list format):
+    #
+    #     :param name: The person's name
+    #     :type name: :py:class:`str`
+    #
+    # Both ``typing.Doc`` (stdlib, Python >= 3.13) and
+    # ``typing_extensions.Doc`` (backport for older Python) are recognised
+    # by ``_extract_doc_description``.
+    # =====================================================================
     if full_name == "typing.Annotated":
         return format_annotation(annotation.__origin__, config, short_literals=short_literals)
     if full_name in {"typing.TypeVar", "typing.ParamSpec"}:
