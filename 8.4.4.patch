+# ---------------------------------------------------------------------------
+# Union type bar syntax version detection (PEP 604)
+# ---------------------------------------------------------------------------
+#
+# PEP 604 (accepted 2020-10-05, Python 3.10) introduced the ``X | Y`` union
+# type syntax as a first-class language feature backed by ``types.UnionType``.
+# This makes it the idiomatic way to express unions from Python 3.10 onward.
+#
+# Prior to Python 3.10, ``Union[X, Y]`` from the ``typing`` module was the
+# only option, so the bar syntax is never the default on older runtimes.
+#
+# Python 3.14 (2025-10) deprecates ``typing.Union`` itself.  At that point
+# the bar form becomes *unconditional* for all union annotations, regardless
+# of any configuration value.
+
+
+def _get_union_bars_default() -> bool:
+    """Return the platform-appropriate default for ``always_use_bars_union``."""
+    return sys.version_info >= (3, 10)
+
+
+def _should_use_bars_union(config: Config, annotation: Any, full_name: str) -> bool:
+    """
+    Determine whether a union-type annotation should render as ``X | Y``.
+
+    Three-tier decision logic (first match wins):
+
+    1. **Python 3.14+ mandatory**: ``typing.Union`` on Python >= 3.14 is
+       *always* rendered as bars because the ``typing.Union`` form is
+       deprecated in the standard library.
+
+    2. **Native ``types.UnionType``**: When the annotation was already
+       written with the ``X | Y`` syntax (PEP 604), its runtime origin is
+       ``types.UnionType``.  Bar rendering is forced — the author already
+       chose it in source code.
+
+    3. **Config-controlled**: For ``typing.Union[X, Y]`` on Python 3.10
+       through 3.13, bar rendering is governed by ``always_use_bars_union``.
+       Since Python 3.10 natively supports ``X | Y``, the config now
+       defaults to ``True`` on Python >= 3.10 (see ``_get_union_bars_default``).
+    """
+    if sys.version_info >= (3, 14) and full_name == "typing.Union":
+        return True
+    if full_name == "types.UnionType":
+        return True
+    always_use_bars_union: bool = getattr(
+        config, "always_use_bars_union", _get_union_bars_default()
+    )
+    return always_use_bars_union and type(annotation).__qualname__ == "_UnionGenericAlias"
+
+
