+    """
+    Extract description text from ``Annotated[T, Doc("...")]`` (PEP 727).
+
+    PEP 727 defines ``typing.Doc`` as a metadata marker that carries a
+    human-readable description alongside a type annotation.  This function
+    walks ``annotation.__metadata__`` and returns the ``documentation``
+    attribute of the *first* ``Doc`` instance encountered.
+
+    Both the standard library ``typing.Doc`` (Python >= 3.13) and the
+    backport ``typing_extensions.Doc`` are recognised.
+
+    Parameters
+    ----------
+    annotation : Any
+        A Python type annotation, typically an instance of
+        ``typing.Annotated`` (internally ``typing._AnnotatedAlias``).
+
+    Returns
+    -------
+    str | None
+        The documentation string if at least one ``Doc`` marker is present
+        inside ``__metadata__``; ``None`` otherwise.
+
+    Notes
+    -----
+    - Only the **first** ``Doc`` is returned.  Multiple ``Doc`` markers in
+      the same ``Annotated`` are legal but the second and subsequent ones
+      are silently ignored.  Authors who need multi-sentence descriptions
+      should compose them into a single ``Doc``.
+    - The extraction runs during ``process_docstring``.  When a docstring
+      already contains a ``:param x: ...`` entry, the manually written text
+      **takes precedence** — the ``Doc`` description is only injected for
+      parameters that lack an explicit description.
+    """
     if not (hasattr(annotation, "__metadata__") and hasattr(annotation, "__origin__")):
         return None
     for meta in annotation.__metadata__:
-        if type(meta).__qualname__ == "Doc" and type(meta).__module__ in {"typing_extensions", "typing"}:
-            return meta.documentation
+        meta_type = type(meta)
+        if meta_type.__qualname__ == "Doc":
+            if meta_type.__module__ in {"typing", "typing_extensions"}:
+                return getattr(meta, "documentation", None)
     return None
 
 
