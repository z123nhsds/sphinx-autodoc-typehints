+class TestUnionBarsPEP604Defaults:
+    """Python-version-aware defaults for ``_get_union_bars_default``."""
+
+    @pytest.mark.skipif(sys.version_info < (3, 10), reason="PEP 604 requires Python 3.10+")
+    def test_default_true_on_python310_plus(self) -> None:
+        from sphinx_autodoc_typehints._annotations import _get_union_bars_default
+        assert _get_union_bars_default() is True, (
+            "Python 3.10+ (PEP 604) defaults to X | Y union syntax"
+        )
+
+    @pytest.mark.skipif(sys.version_info >= (3, 10), reason="Python < 3.10 only")
+    def test_default_false_on_python_below_310(self) -> None:
+        from sphinx_autodoc_typehints._annotations import _get_union_bars_default
+        assert _get_union_bars_default() is False, (
+            "Python < 3.10 defaults to Union[X, Y] syntax"
+        )
+
+    @pytest.mark.skipif(sys.version_info < (3, 14), reason="Python 3.14+ only")
+    def test_mandatory_on_python314_plus(self) -> None:
+        from sphinx_autodoc_typehints._annotations import _should_use_bars_union
+        from unittest.mock import create_autospec
+
+        from sphinx.config import Config
+
+        conf = create_autospec(Config, always_use_bars_union=False)
+        annotation = Union[int, str]
+        assert _should_use_bars_union(conf, annotation, "typing.Union") is True, (
+            "Python 3.14+ mandates bars for typing.Union regardless of config"
+        )
+
+
+class TestExtractDocDescription:
+    """Extended coverage for ``_extract_doc_description``."""
+
+    def test_multiple_docs_returns_first(self) -> None:
+        annotation = Annotated[int, Doc("alpha"), Doc("beta")]
+        assert _extract_doc_description(annotation) == "alpha"
+
+    def test_no_doc_marker_returns_none(self) -> None:
+        annotation = Annotated[int, 42]
+        assert _extract_doc_description(annotation) is None
+
+    def test_plain_type_returns_none(self) -> None:
+        assert _extract_doc_description(int) is None
+
+    def test_typing_extensions_doc_recognised(self) -> None:
+        annotation = Annotated[str, Doc("backport doc")]
+        assert _extract_doc_description(annotation) == "backport doc"
+
+
