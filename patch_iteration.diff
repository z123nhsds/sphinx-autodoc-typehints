+def _extract_doc_from_nested_annotated(annotation: Any) -> str | None:
+    """Recursively walk ``Annotated`` / generic aliases to find a ``Doc(...)`` marker.
+
+    Picks up ``Doc`` from nested ``Annotated`` wrappers (PEP 593) as well as
+    from union members -- useful when a project writes
+    ``Annotated[int, Doc("count")] | None`` or ``Union[Annotated[X, Doc(...)], Y]``.
+    Returns the first documentation string found (depth-first).
+    """
+    visited: set[int] = set()
+
+    def _walk(obj: Any) -> str | None:
+        if obj is None or obj is inspect.Parameter.empty:
+            return None
+        # Guard against recursive generic types (extremely defensive).
+        obj_id = id(obj)
+        if obj_id in visited:
+            return None
+        visited.add(obj_id)
+
+        # Annotated[T, ...] -- check its own metadata first.
+        if hasattr(obj, "__metadata__") and hasattr(obj, "__origin__"):
+            doc = _extract_doc_description(obj)
+            if doc:
+                return doc
+            # Fall through and scan Annotated's own args too (they carry the inner type).
+            inner = getattr(obj, "__origin__", None)
+            if inner is not None:
+                doc = _walk(inner)
+                if doc:
+                    return doc
+
+        # Union / X | Y -- scan members.
+        origin = getattr(obj, "__origin__", None)
+        args: Iterable[Any] | None = None
+        if origin is type(None):  # pragma: no cover
+            return None
+        if origin is not None:
+            args = getattr(obj, "__args__", None)
+        if args is None and isinstance(obj, tuple):
+            args = obj
+        if args:
+            for arg in args:
+                doc = _walk(arg)
+                if doc:
+                    return doc
+        return None
+
+    return _walk(annotation)
+
+
+def _strip_no_rtype_directive(lines: list[str]) -> bool:
+    """Remove a ``:no-rtype:`` directive from the docstring; return True if found.
+
+    The directive allows per-function opt-out for return-type injection.
+    """
+    for idx, line in enumerate(lines):
+        if line.strip() == ":no-rtype:":
+            del lines[idx]
+            return True
+    return False
+
