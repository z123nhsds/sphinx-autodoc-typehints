+def _unwrap_annotated(annotation: Any) -> Any:
+    """Strip one level of ``Annotated[T, ...]`` wrapper.
+
+    PEP 593 ``Annotated`` carries the actual type in ``__origin__`` (Python 3.9+)
+    or as the first element of ``__args__``. We return the underlying type so
+    that callers of :func:`format_annotation` can render ``T`` instead of the
+    full ``Annotated[T, Doc(...), ...]`` expansion. If the argument isn't an
+    ``Annotated`` wrapper, it is returned unchanged.
+    """
+    # Standard ``typing.Annotated`` / ``typing_extensions.Annotated`` expose
+    # ``__origin__`` once parametrised.
+    origin = getattr(annotation, "__origin__", None)
+    args = getattr(annotation, "__args__", None)
+    if origin is not None and args is not None:
+        # ``Annotated[T, ...]`` -> ``T``
+        return args[0] if args else origin
+    return annotation
