--- a/conf.py
+++ b/conf.py
@@ -14,0 +15,28 @@
+
+extensions = [
+    "sphinx.ext.napoleon",
+    "sphinx_autodoc_typehints",
+]
+
+autodoc_typehints = "none"
+
+import warnings
+warnings.filterwarnings("ignore", message=".*guarded_import.*")
+warnings.filterwarnings("ignore", message=".*local_function.*")
+
+intersphinx_mapping = {
+    "python": ("https://docs.python.org/3", None),
+}
+
+# typehints将threading.local等类型映射为标准库文档路径，
+# 启用intersphinx后自动修复交叉引用链接
+
+typehints_use_signature = True
+typehints_use_signature_return = False