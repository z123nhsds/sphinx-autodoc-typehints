+from __future__ import annotations
+
+from pathlib import Path
+from textwrap import dedent
+from typing import TYPE_CHECKING
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from conftest import make_sig_app
+from sphinx_autodoc_typehints import process_signature
+from sphinx_autodoc_typehints._resolver._util import get_obj_location
+
+if TYPE_CHECKING:
+    from io import StringIO
+
+    from sphinx.testing.util import SphinxTestApp
+
+
+class TestLocalFunctionWarning:
+    """Test that referencing a local function triggers sphinx_autodoc_typehints.local_function warning."""
+
+    def test_local_function_triggers_warning(self) -> None:
+        """Scenario: a method with <locals> in its __qualname__ is processed.
+        Expected: a warning with type='sphinx_autodoc_typehints' and subtype='local_function' is emitted."""
+        def fake_method(self: object, x: int) -> str: ...
+
+        fake_method.__annotations__ = {"x": int, "return": str}
+        fake_method.__qualname__ = "outer.<locals>.inner"
+        fake_method.__module__ = __name__
+
+        app = make_sig_app()
+        mock_logger = MagicMock()
+        with patch("sphinx_autodoc_typehints._LOGGER", mock_logger):
+            process_signature(app, "method", "test.outer.<locals>.inner", fake_method, MagicMock(), "", "")
+        mock_logger.warning.assert_called_once()
+        kwargs = mock_logger.warning.call_args.kwargs
+        assert kwargs["type"] == "sphinx_autodoc_typehints"
+        assert kwargs["subtype"] == "local_function"
+        assert "Cannot handle as a local function" in kwargs[0] if kwargs[0] else "Cannot handle as a local function" in str(mock_logger.warning.call_args)
+
+    def test_local_function_warning_returns_none(self) -> None:
+        """Scenario: a local function is processed.
+        Expected: process_signature returns None, signaling that the signature cannot be handled."""
+        def fake_method(self: object, x: int) -> str: ...
+
+        fake_method.__annotations__ = {"x": int, "return": str}
+        fake_method.__qualname__ = "outer.<locals>.inner"
+        fake_method.__module__ = __name__
+
+        app = make_sig_app()
+        mock_logger = MagicMock()
+        with patch("sphinx_autodoc_typehints._LOGGER", mock_logger):
+            result = process_signature(app, "method", "test.outer.<locals>.inner", fake_method, MagicMock(), "", "")
+        assert result is None
+
+
+class TestSuppressLocalFunctionWarning:
+    """Test conf.py configuration to suppress local_function warnings."""
+    # To suppress sphinx_autodoc_typehints.local_function warnings in conf.py, add:
+    #   suppress_warnings = ["sphinx_autodoc_typehints.local_function"]
+    # This uses Sphinx's built-in suppress_warnings mechanism which filters warnings
+    # by their type and subtype fields.
+    pass
