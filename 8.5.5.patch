+++ b/tests/test_config_options.py
@@ -0,0 +1,39 @@
+from __future__ import annotations
+
+from typing import Union
+from unittest.mock import create_autospec
+
+from sphinx.config import Config
+
+from sphinx_autodoc_typehints import format_annotation
+
+
+class TestAlwaysUseBarsUnion:
+    """Test always_use_bars_union configuration option."""
+
+    def test_always_use_bars_union_false_shows_union(self) -> None:
+        """When always_use_bars_union=False, Union[X, Y] is rendered as
+        :py:data:`~typing.Union`\\ [:py:class:`X`, :py:class:`Y`]."""
+        conf = create_autospec(Config, _annotation_globals=globals(), always_use_bars_union=False)
+        result = format_annotation(Union[int, str], conf)
+        assert ":py:data:`~typing.Union`" in result
+        assert "int" in result
+        assert "str" in result
+        assert "|" not in result
+
+    def test_always_use_bars_union_true_shows_bars(self) -> None:
+        """When always_use_bars_union=True, Union[X, Y] is rendered as
+        :py:class:`int` | :py:class:`str`."""
+        conf = create_autospec(Config, _annotation_globals=globals(), always_use_bars_union=True)
+        result = format_annotation(Union[int, str], conf)
+        assert "|" in result
+        assert ":py:class:`int`" in result
+        assert ":py:class:`str`" in result
+        assert "Union" not in result
+
+    def test_bars_union_with_none(self) -> None:
+        """When always_use_bars_union=True, Union[int, None] renders as
+        :py:class:`int` | :py:obj:`None`."""
+        conf = create_autospec(Config, _annotation_globals=globals(), always_use_bars_union=True)
+        result = format_annotation(Union[int, None], conf)
+        assert ":py:class:`int`" in result
+        assert ":py:obj:`None`" in result
+        assert "|" in result
