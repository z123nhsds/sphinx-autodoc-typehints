@@ -0,0 +1,67 @@
+from __future__ import annotations
+
+from pathlib import Path
+from textwrap import dedent
+from typing import TYPE_CHECKING
+
+import pytest
+
+from conftest import make_sig_app
+from sphinx_autodoc_typehints import process_signature
+
+if TYPE_CHECKING:
+    from io import StringIO
+
+    from sphinx.testing.util import SphinxTestApp
+
+
+class TestSignaturePreservation:
+    """Test typehints_use_signature=True and typehints_use_signature_return=False."""
+
+    def test_param_types_in_signature_return_not_in_signature(self) -> None:
+        """When typehints_use_signature=True and typehints_use_signature_return=False:
+        Verification point 1: parameter type annotations appear in the signature string.
+        Verification point 2: return type annotation does NOT appear in the signature string."""
+        def func(x: int, y: str) -> bool: ...
+
+        app = make_sig_app(typehints_use_signature=True, typehints_use_signature_return=False)
+        result = process_signature(app, "function", "test.func", func, None, "", "")
+        assert result is not None
+        sig_str, _ = result
+
+        # Verification point 1: parameter types appear in signature
+        assert "int" in sig_str
+        assert "str" in sig_str
+
+        # Verification point 2: return type does NOT appear in signature
+        assert "bool" not in sig_str
+        assert "->" not in sig_str
+
+    def test_both_signature_and_return_enabled(self) -> None:
+        """When typehints_use_signature=True and typehints_use_signature_return=True:
+        Both parameter types and return type appear in the signature string."""
+        def func(x: int, y: str) -> bool: ...
+
+        app = make_sig_app(typehints_use_signature=True, typehints_use_signature_return=True)
+        result = process_signature(app, "function", "test.func", func, None, "", "")
+        assert result is not None
+        sig_str, _ = result
+
+        assert "int" in sig_str
+        assert "str" in sig_str
+        assert "bool" in sig_str
+
+    def test_neither_signature_nor_return_enabled(self) -> None:
+        """When typehints_use_signature=False and typehints_use_signature_return=False:
+        Neither parameter types nor return type appear in the signature string."""
+        def func(x: int, y: str) -> bool: ...
+
+        app = make_sig_app(typehints_use_signature=False, typehints_use_signature_return=False)
+        result = process_signature(app, "function", "test.func", func, None, "", "")
+        assert result is not None
+        sig_str, _ = result
+
+        assert "int" not in sig_str
+        assert "str" not in sig_str
+        assert "bool" not in sig_str
+        assert "->" not in sig_str
