@@ -0,0 +1,109 @@
+from __future__ import annotations
+
+import sys
+import types
+from pathlib import Path
+from textwrap import dedent
+from typing import TYPE_CHECKING, Union
+
+import pytest
+
+from sphinx_autodoc_typehints._resolver._type_hints import (
+    _resolve_type_guarded_imports,
+    _should_skip_guarded_import_resolution,
+    get_all_type_hints,
+)
+
+if TYPE_CHECKING:
+    from io import StringIO
+
+    from sphinx.testing.util import SphinxTestApp
+
+
+class TestTypeCheckingBlockResolution:
+    """Test that functions can resolve types from TYPE_CHECKING blocks."""
+
+    def test_resolve_type_from_typing_checking_block(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        """Scenario: a module imports a type inside `if TYPE_CHECKING:` and uses it in a function annotation.
+        Expected: get_all_type_hints resolves the guarded import and returns the real type."""
+        source = dedent("""\
+        from __future__ import annotations
+        from typing import TYPE_CHECKING
+
+        if TYPE_CHECKING:
+            from decimal import Decimal
+
+        def func(x: Decimal) -> Decimal:
+            '''Do something.
+
+            :param x: a decimal
+            '''
+            return x
+        """)
+        guarded_mod = types.ModuleType("guarded_mod")
+        guarded_mod.__file__ = "/fake/guarded_mod.py"
+        exec(compile(source, "/fake/guarded_mod.py", "exec"), guarded_mod.__dict__)  # noqa: S102
+        monkeypatch.setitem(sys.modules, "guarded_mod", guarded_mod)
+
+        result = get_all_type_hints([], guarded_mod.func, "guarded_mod.func", {})
+        from decimal import Decimal
+        assert result.get("x") is Decimal
+        assert result.get("return") is Decimal
+
+    def test_resolve_missing_guarded_import_no_crash(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        """Scenario: a TYPE_CHECKING block imports a name that does not exist at runtime.
+        Expected: resolution does not crash; the type hint remains a string or is gracefully handled."""
+        source = dedent("""\
+        from __future__ import annotations
+        from typing import TYPE_CHECKING
+
+        if TYPE_CHECKING:
+            from nonexistent_module import MissingType
+
+        def func(x: MissingType) -> int:
+            '''Do something.
+
+            :param x: something
+            '''
+            return 1
+        """)
+        guarded_mod = types.ModuleType("guarded_mod_missing")
+        guarded_mod.__file__ = "/fake/guarded_mod_missing.py"
+        exec(compile(source, "/fake/guarded_mod_missing.py", "exec"), guarded_mod.__dict__)  # noqa: S102
+        monkeypatch.setitem(sys.modules, "guarded_mod_missing", guarded_mod)
+
+        result = get_all_type_hints([], guarded_mod.func, "guarded_mod_missing.func", {})
+        assert isinstance(result, dict)
+
+    def test_resolve_typing_checking_with_qualified_import(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        """Scenario: a TYPE_CHECKING block uses `if typing.TYPE_CHECKING:` (qualified form).
+        Expected: the guarded import is still resolved correctly."""
+        source = dedent("""\
+        from __future__ import annotations
+        import typing
+
+        if typing.TYPE_CHECKING:
+            from collections.abc import Sequence
+
+        def func(x: Sequence[int]) -> int:
+            '''Do something.
+
+            :param x: a sequence
+            '''
+            return len(x)
+        """)
+        guarded_mod = types.ModuleType("guarded_mod_qualified")
+        guarded_mod.__file__ = "/fake/guarded_mod_qualified.py"
+        exec(compile(source, "/fake/guarded_mod_qualified.py", "exec"), guarded_mod.__dict__)  # noqa: S102
+        monkeypatch.setitem(sys.modules, "guarded_mod_qualified", guarded_mod)
+
+        result = get_all_type_hints([], guarded_mod.func, "guarded_mod_qualified.func", {})
+        from collections.abc import Sequence
+        assert result.get("x") is not None
+        assert "Sequence" in str(result.get("x"))
+
+    def test_should_skip_guarded_for_builtin_module(self) -> None:
+        """Scenario: object's __module__ is in sys.builtin_module_names.
+        Expected: _should_skip_guarded_import_resolution returns True, no resolution attempted."""
+        fn: object = type("FakeFunc", (), {"__globals__": {}, "__module__": "builtins"})()
+        assert _should_skip_guarded_import_resolution(fn) is True
+
+    def test_should_not_skip_guarded_for_regular_module(self) -> None:
+        """Scenario: object's __module__ is a normal user module.
+        Expected: _should_skip_guarded_import_resolution returns False, resolution proceeds."""
+        import csv
+        assert _should_skip_guarded_import_resolution(csv) is False
