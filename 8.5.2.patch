+def test_get_type_hint_resolves_type_from_type_checking_block(monkeypatch: pytest.MonkeyPatch) -> None:
+    guarded_dep = types.ModuleType("guarded_dep")
+
+    class GuardedType:
+        pass
+
+    guarded_dep.GuardedType = GuardedType
+    guarded_user = types.ModuleType("guarded_user")
+    guarded_user.__file__ = "/fake/guarded_user.py"
+    source = (
+        "from __future__ import annotations\n"
+        "from typing import TYPE_CHECKING\n\n"
+        "if TYPE_CHECKING:\n"
+        "    from guarded_dep import GuardedType\n\n"
+        "def func(value: GuardedType) -> GuardedType:\n"
+        "    return value\n"
+    )
+    exec(compile(source, guarded_user.__file__, "exec"), guarded_user.__dict__)
+
+    monkeypatch.setitem(sys.modules, "guarded_dep", guarded_dep)
+    monkeypatch.setitem(sys.modules, "guarded_user", guarded_user)
+    _TYPE_GUARD_IMPORTS_RESOLVED.discard("guarded_user")
+
+    try:
+        assert "GuardedType" not in guarded_user.__dict__
+        result = _get_type_hint([], "guarded_user.func", guarded_user.func, {})
+        assert result["value"] is GuardedType
+        assert result["return"] is GuardedType
+        assert guarded_user.__dict__["GuardedType"] is GuardedType
+    finally:
+        _TYPE_GUARD_IMPORTS_RESOLVED.discard("guarded_user")
+
