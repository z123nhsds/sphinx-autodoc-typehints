--- a/conf.py
+++ b/conf.py
@@ -1,2 +1,22 @@
-extensions = ["sphinx.ext.autodoc"]
-autodoc_typehints = "description"
+extensions = [
+    "sphinx.ext.autodoc",
+    "sphinx.ext.napoleon",
+    "sphinx_autodoc_typehints",
+]
+
+# 禁用 Sphinx 内置处理以避免与扩展产生的类型提示重复
+autodoc_typehints = "none"
+
+# sphinx-autodoc-typehints 配置
+always_use_bars_union = True            # 使用 X | Y 联合类型
+typehints_document_rtype_none = False   # 不显示 None 返回类型
+typehints_defaults = "braces-after"     # 默认值以 braces-after 方式显示
+typehints_use_signature = True          # 保留函数签名中的参数类型
+typehints_use_signature_return = True   # 保留函数签名中的返回类型
+
+# 修复 gi.repository.Gtk.Window 的 intersphinx 链接
+def fixup_module_name(module: str) -> str:
+    if module.startswith("gi.repository."):
+        return module.removeprefix("gi.repository.")
+    return module
+
+typehints_fixup_module_name = fixup_module_name