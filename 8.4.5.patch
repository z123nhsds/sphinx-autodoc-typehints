diff --git a/src/sphinx_autodoc_typehints/_doc_extract.py b/src/sphinx_autodoc_typehints/_doc_extract.py
new file mode 100644
--- /dev/null
+++ b/src/sphinx_autodoc_typehints/_doc_extract.py
@@ -0,0 +1,85 @@
+"""
+Annotated[T, Doc(...)] 描述信息提取模块。
+
+从 Python 类型注解中提取 Doc 元数据，并转换为 Sphinx docstring 格式。
+支持 typing_extensions.Doc 和 Python 3.14+ 的 typing.Doc。
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:
+    from sphinx.application import Sphinx
+
+
+def extract_annotated_doc(
+    annotation: Any,
+    arg_name: str,
+    lines: list[str],
+) -> bool:
+    """
+    从 Annotated[T, Doc(...)] 中提取描述信息并写入 docstring。
+    
+    参数:
+        annotation: 类型注解，可能是 Annotated[T, Doc("description")] 或普通类型
+        arg_name: 参数名称
+        lines: docstring 行列表（会被修改）
+        
+    返回:
+        bool: 是否成功提取到 Doc 描述
+        
+    示例:
+        >>> def func(name: Annotated[str, Doc("The user's name")]) -> None:
+        ...     pass
+        >>> # 自动在 docstring 中添加 :param name: The user's name
+    """
+    doc = _extract_doc_description(annotation)
+    if doc is None:
+        return False
+    
+    # 检查是否已存在该参数的 :param: 字段
+    # docstring 中的描述优先级更高
+    if _has_param_doc(lines, arg_name):
+        return False
+    
+    # 添加 :param arg_name: description 到 docstring
+    lines.append(f":param {arg_name}: {doc}")
+    return True
+
+
+def extract_return_doc(
+    return_annotation: Any,
+    lines: list[str],
+) -> bool:
+    """
+    从返回值的 Annotated[T, Doc(...)] 中提取描述信息并写入 docstring。
+    
+    参数:
+        return_annotation: 返回类型注解
+        lines: docstring 行列表（会被修改）
+        
+    返回:
+        bool: 是否成功提取到 Doc 描述
+        
+    示例:
+        >>> def func() -> Annotated[str, Doc("The greeting message")]:
+        ...     pass
+        >>> # 自动在 docstring 中添加 :return: The greeting message
+    """
+    doc = _extract_doc_description(return_annotation)
+    if doc is None:
+        return False
+    
+    # 检查是否已存在 :return: 或 :returns: 字段
+    if _has_return_doc(lines):
+        return False
+    
+    # 添加 :return: description 到 docstring
+    lines.append(f":return: {doc}")
+    return True
+
+
+def _extract_doc_description(annotation: Any) -> str | None:
+    """从 Annotated 类型的 __metadata__ 中提取 Doc 描述。"""
+    if not (hasattr(annotation, "__metadata__") and hasattr(annotation, "__origin__")):
+        return None
+    for meta in annotation.__metadata__:
+        if type(meta).__qualname__ == "Doc" and type(meta).__module__ in {"typing_extensions", "typing"}:
+            return meta.documentation
+    return None
+
+
+def _has_param_doc(lines: list[str], arg_name: str) -> bool:
+    """检查 docstring 中是否已存在该参数的 :param: 字段。"""
+    param_prefix = f":param {arg_name}:"
+    return any(line.lstrip().startswith(param_prefix) for line in lines)
+
+
+def _has_return_doc(lines: list[str]) -> bool:
+    """检查 docstring 中是否已存在 :return: 或 :returns: 字段。"""
+    return any(
+        line.lstrip().startswith((":return:", ":returns:"))
+        for line in lines
+    )
